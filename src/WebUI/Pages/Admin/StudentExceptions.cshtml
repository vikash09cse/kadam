@page
@model WebUI.Pages.Admin.StudentExceptionsModel
@{
    ViewData["Title"] = "Student Exceptions";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Student Exceptions</h4>
                    <a class="btn btn-soft-primary btn-sm"
                       asp-page="/Admin/StudentAnalytics"
                               asp-route-StateId="@Model.StateId"
                               asp-route-DivisionId="@Model.DivisionId"
                               asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                               asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                               asp-route-IncludeAll="@Model.IncludeAll"
                               asp-route-IncludeKadam="@Model.IncludeKadam"
                               asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus">
                        Back to analytics
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form method="get">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="StateId" class="form-label">State</label>
                                    <select asp-for="StateId" id="StateId" class="form-select">
                                        <option value="">All States</option>
                                        @foreach (var state in Model.States)
                                        {
                                            <option value="@state.Value">@state.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="DivisionId" class="form-label">Division</label>
                                    <select asp-for="DivisionId" id="DivisionId" class="form-select">
                                        <option value="">All Divisions</option>
                                        @foreach (var division in Model.Divisions)
                                        {
                                            <option value="@division.Value">@division.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="FromDate" class="form-label">From Date</label>
                                    <input asp-for="FromDate" type="date" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ToDate" class="form-label">To Date</label>
                                    <input asp-for="ToDate" type="date" class="form-control" />
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-4">
                                    <label asp-for="ExceptionCode" class="form-label">Exception type</label>
                                    <select asp-for="ExceptionCode" class="form-select">
                                        <option value="">All exceptions</option>
                                        @foreach (var option in StudentExceptionsModel.ExceptionOptions)
                                        {
                                            <option value="@option.Code">@option.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label d-block">Student Type</label>
                                    <div class="d-flex flex-wrap gap-4">
                                        <div class="form-check">
                                            <input asp-for="IncludeAll" class="form-check-input" type="checkbox" id="includeAll" />
                                            <label class="form-check-label" for="includeAll">All</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="IncludeKadam" class="form-check-input student-type-filter" type="checkbox" id="includeKadam" />
                                            <label class="form-check-label" for="includeKadam">Kadam</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="IncludeKadamPlus" class="form-check-input student-type-filter" type="checkbox" id="includeKadamPlus" />
                                            <label class="form-check-label" for="includeKadamPlus">Kadam Plus</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-3">
                                    <label asp-for="DaysNoBaseline" class="form-label">Days without baseline</label>
                                    <input asp-for="DaysNoBaseline" type="number" min="0" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="DaysStuck" class="form-label">Days stuck after baseline</label>
                                    <input asp-for="DaysStuck" type="number" min="0" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="DaysInactive" class="form-label">Days long inactive</label>
                                    <input asp-for="DaysInactive" type="number" min="0" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="PageSize" class="form-label">Page size</label>
                                    <input asp-for="PageSize" type="number" min="1" max="200" class="form-control" />
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">Apply Filters</button>
                                <a asp-page="/Admin/StudentExceptions" class="btn btn-secondary">Clear</a>
                                <a class="btn btn-success"
                                   asp-page-handler="DownloadExcel"
                                   asp-route-StateId="@Model.StateId"
                                   asp-route-DivisionId="@Model.DivisionId"
                                   asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-IncludeAll="@Model.IncludeAll"
                                   asp-route-IncludeKadam="@Model.IncludeKadam"
                                   asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus"
                                   asp-route-ExceptionCode="@Model.ExceptionCode"
                                   asp-route-DaysNoBaseline="@Model.DaysNoBaseline"
                                   asp-route-DaysStuck="@Model.DaysStuck"
                                   asp-route-DaysInactive="@Model.DaysInactive">
                                    Export Excel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title text-primary mb-0">Exception list</h5>
                            <span class="text-muted small">@Model.TotalCount record(s)</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Exception</th>
                                        <th>Student Id</th>
                                        <th>Name</th>
                                        <th>Institution</th>
                                        <th>Division</th>
                                        <th>Grade</th>
                                        <th>Status</th>
                                        <th>Enrollment</th>
                                        <th>Last / Exit step</th>
                                        <th>Days overdue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Rows.Any())
                                    {
                                        <tr><td colspan="10" class="text-center text-muted py-4">No exceptions for the selected filters.</td></tr>
                                    }
                                    else
                                    {
                                        foreach (var row in Model.Rows)
                                        {
                                            <tr>
                                                <td>@row.ExceptionLabel</td>
                                                <td>@row.StudentCode</td>
                                                <td>@row.StudentName</td>
                                                <td>@row.InstitutionName</td>
                                                <td>@row.DivisionName</td>
                                                <td>@row.GradeName @row.Section</td>
                                                <td>@row.CurrentStatusText</td>
                                                <td>@(row.EnrollmentDate?.ToString("dd-MMM-yyyy"))</td>
                                                <td>@(row.LastProgressStepId?.ToString() ?? "-") / @(row.ExitStepId?.ToString() ?? "-")</td>
                                                <td>@(row.DaysOverdue?.ToString() ?? "-")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (Model.TotalPages > 1)
                        {
                            <nav class="mt-3">
                                <ul class="pagination mb-0">
                                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                                        <a class="page-link"
                                           asp-page="/Admin/StudentExceptions"
                                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                                           asp-route-PageSize="@Model.PageSize"
                                           asp-route-StateId="@Model.StateId"
                                           asp-route-DivisionId="@Model.DivisionId"
                                           asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-IncludeAll="@Model.IncludeAll"
                                           asp-route-IncludeKadam="@Model.IncludeKadam"
                                           asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus"
                                           asp-route-ExceptionCode="@Model.ExceptionCode"
                                           asp-route-DaysNoBaseline="@Model.DaysNoBaseline"
                                           asp-route-DaysStuck="@Model.DaysStuck"
                                           asp-route-DaysInactive="@Model.DaysInactive">Previous</a>
                                    </li>
                                    <li class="page-item disabled">
                                        <span class="page-link">Page @Model.PageNumber of @Model.TotalPages</span>
                                    </li>
                                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                                        <a class="page-link"
                                           asp-page="/Admin/StudentExceptions"
                                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                                           asp-route-PageSize="@Model.PageSize"
                                           asp-route-StateId="@Model.StateId"
                                           asp-route-DivisionId="@Model.DivisionId"
                                           asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                           asp-route-IncludeAll="@Model.IncludeAll"
                                           asp-route-IncludeKadam="@Model.IncludeKadam"
                                           asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus"
                                           asp-route-ExceptionCode="@Model.ExceptionCode"
                                           asp-route-DaysNoBaseline="@Model.DaysNoBaseline"
                                           asp-route-DaysStuck="@Model.DaysStuck"
                                           asp-route-DaysInactive="@Model.DaysInactive">Next</a>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const includeAll = document.getElementById('includeAll');
            const typeFilters = document.querySelectorAll('.student-type-filter');
            function syncStudentTypeFilters() {
                if (includeAll.checked) typeFilters.forEach(function (c) { c.checked = false; });
            }
            includeAll.addEventListener('change', syncStudentTypeFilters);
            typeFilters.forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    if (checkbox.checked) includeAll.checked = false;
                });
            });
            syncStudentTypeFilters();

            const stateSelect = document.getElementById('StateId');
            const divisionSelect = document.getElementById('DivisionId');
            function escapeHtml(value) {
                return String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
            stateSelect?.addEventListener('change', async function () {
                if (!divisionSelect) return;
                const response = await fetch(`?handler=DivisionsByState&stateId=${encodeURIComponent(stateSelect.value || '')}`);
                if (!response.ok) return;
                const data = await response.json();
                divisionSelect.innerHTML = ['<option value="">All Divisions</option>']
                    .concat((data || []).map(function (d) { return `<option value="${d.value}">${escapeHtml(d.text)}</option>`; }))
                    .join('');
                divisionSelect.value = '';
            });
        })();
    </script>
}
