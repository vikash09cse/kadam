@page "{userId:int}"
@model WebUI.Pages.Admin.UserMenuPermissionsModel
@{
    ViewData["Title"] = "User Menu Permissions";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Menu Permissions - @Model.UserFullName</h4>
                    <div class="text-end">
                        <a href="/Admin/Peoples" class="btn btn-light">
                            <i class="mdi mdi-arrow-left"></i> Back to Peoples
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                        {
                            <div class="alert alert-success">@Model.SuccessMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }

                        <p class="text-muted mb-4">
                            Select the menus this user can access. Parent menus are shown automatically when a child menu is assigned.
                            Admin users always see all menus regardless of these settings.
                            Add/Edit and Delete on a user override the role defaults for that page.
                        </p>

                        <form method="post">
                            <input type="hidden" asp-for="UserId" />

                            <div class="permissions-list border rounded p-3" style="max-height: 560px; overflow-y: auto;">
                                <div class="row fw-semibold border-bottom pb-2 mb-2 d-none d-md-flex align-items-center">
                                    <div class="col-md-6">Menu</div>
                                    <div class="col-md-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="checkAllAccess" />
                                            <label class="form-check-label" for="checkAllAccess">Access</label>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="checkAllAddEdit" />
                                            <label class="form-check-label" for="checkAllAddEdit">Add/Edit</label>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="checkAllDelete" />
                                            <label class="form-check-label" for="checkAllDelete">Delete</label>
                                        </div>
                                    </div>
                                </div>
                                @foreach (var menu in Model.Menus)
                                {
                                    var isChild = menu.ParentId.HasValue && menu.ParentId.Value > 0;
                                    <div class="row align-items-center mb-2 @(isChild ? "ms-3" : "") permission-row">
                                        <div class="col-md-6">
                                            <label class="form-check-label" for="menu_@menu.Id">
                                                @menu.MenuName
                                                @if (isChild && !string.IsNullOrWhiteSpace(menu.ParentMenuName))
                                                {
                                                    <small class="text-muted">(@menu.ParentMenuName)</small>
                                                }
                                                @if (menu.IsInherited)
                                                {
                                                    <small class="text-muted">from role</small>
                                                }
                                            </label>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-check">
                                                <input class="form-check-input js-access"
                                                       type="checkbox"
                                                       name="SelectedMenuIds"
                                                       value="@menu.Id"
                                                       id="menu_@menu.Id"
                                                       @(Model.SelectedMenuIds.Contains(menu.Id) ? "checked" : null) />
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            @if (menu.HasActions)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input js-add-edit"
                                                           type="checkbox"
                                                           name="AddEditMenuIds"
                                                           value="@menu.Id"
                                                           @(Model.AddEditMenuIds.Contains(menu.Id) ? "checked" : null) />
                                                </div>
                                            }
                                        </div>
                                        <div class="col-md-2">
                                            @if (menu.HasActions)
                                            {
                                                <div class="form-check">
                                                    <input class="form-check-input js-delete"
                                                           type="checkbox"
                                                           name="DeleteMenuIds"
                                                           value="@menu.Id"
                                                           @(Model.DeleteMenuIds.Contains(menu.Id) ? "checked" : null) />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">
                                    <i class="mdi mdi-content-save"></i> Save Menu Permissions
                                </button>
                                <a href="/Admin/Peoples" class="btn btn-light ms-2">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var rows = Array.from(document.querySelectorAll('.permission-row'));
            var checkAllAccess = document.getElementById('checkAllAccess');
            var checkAllAddEdit = document.getElementById('checkAllAddEdit');
            var checkAllDelete = document.getElementById('checkAllDelete');

            function boxes(selector) {
                return rows.map(function (row) { return row.querySelector(selector); }).filter(Boolean);
            }

            function setHeaderState(header, items) {
                if (!header || items.length === 0) {
                    if (header) {
                        header.checked = false;
                        header.indeterminate = false;
                    }
                    return;
                }
                var checkedCount = items.filter(function (item) { return item.checked; }).length;
                header.checked = checkedCount === items.length;
                header.indeterminate = checkedCount > 0 && checkedCount < items.length;
            }

            function refreshHeaders() {
                setHeaderState(checkAllAccess, boxes('.js-access'));
                setHeaderState(checkAllAddEdit, boxes('.js-add-edit'));
                setHeaderState(checkAllDelete, boxes('.js-delete'));
            }

            function syncRowFromAccess(row) {
                var access = row.querySelector('.js-access');
                if (!access || access.checked) return;
                var addEdit = row.querySelector('.js-add-edit');
                var del = row.querySelector('.js-delete');
                if (addEdit) addEdit.checked = false;
                if (del) del.checked = false;
            }

            function syncRowToAccess(row) {
                var access = row.querySelector('.js-access');
                var addEdit = row.querySelector('.js-add-edit');
                var del = row.querySelector('.js-delete');
                if (!access) return;
                if ((addEdit && addEdit.checked) || (del && del.checked)) {
                    access.checked = true;
                }
            }

            rows.forEach(function (row) {
                var access = row.querySelector('.js-access');
                var addEdit = row.querySelector('.js-add-edit');
                var del = row.querySelector('.js-delete');
                if (!access) return;

                access.addEventListener('change', function () {
                    syncRowFromAccess(row);
                    refreshHeaders();
                });
                if (addEdit) addEdit.addEventListener('change', function () {
                    syncRowToAccess(row);
                    refreshHeaders();
                });
                if (del) del.addEventListener('change', function () {
                    syncRowToAccess(row);
                    refreshHeaders();
                });
            });

            if (checkAllAccess) {
                checkAllAccess.addEventListener('change', function () {
                    boxes('.js-access').forEach(function (item) {
                        item.checked = checkAllAccess.checked;
                    });
                    rows.forEach(syncRowFromAccess);
                    refreshHeaders();
                });
            }
            if (checkAllAddEdit) {
                checkAllAddEdit.addEventListener('change', function () {
                    boxes('.js-add-edit').forEach(function (item) {
                        item.checked = checkAllAddEdit.checked;
                    });
                    rows.forEach(syncRowToAccess);
                    refreshHeaders();
                });
            }
            if (checkAllDelete) {
                checkAllDelete.addEventListener('change', function () {
                    boxes('.js-delete').forEach(function (item) {
                        item.checked = checkAllDelete.checked;
                    });
                    rows.forEach(syncRowToAccess);
                    refreshHeaders();
                });
            }

            refreshHeaders();
        })();
    </script>
}
