@page
@model WebUI.Pages.Admin.FollowupReportModel
@{
    ViewData["Title"] = "Student Follow-up Report";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Student Follow-up Report</h4>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <p class="text-muted mb-4">
                            Class visit follow-ups for the selected filters. Default period is the current month.
                            Results are limited to institutions you can access.
                        </p>

                        <form method="post" id="followupReportForm">
                            @Html.AntiForgeryToken()
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>

                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="StateId" class="form-label">State</label>
                                    <select asp-for="StateId" id="StateId" class="form-select">
                                        <option value="0">All States</option>
                                        @foreach (var state in Model.States)
                                        {
                                            <option value="@state.Value">@state.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="DivisionId" class="form-label">Division</label>
                                    <select asp-for="DivisionId" id="DivisionId" class="form-select">
                                        <option value="0">All Divisions</option>
                                        @foreach (var division in Model.Divisions)
                                        {
                                            <option value="@division.Value">@division.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="InstitutionId" class="form-label">Institution</label>
                                    <select asp-for="InstitutionId" id="InstitutionId" class="form-select institution-select2">
                                        <option value="0">All Institutions</option>
                                        @foreach (var institution in Model.Institutions)
                                        {
                                            <option value="@institution.Value">@institution.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="GradeId" class="form-label">Grade</label>
                                    <select asp-for="GradeId" id="GradeId" class="form-select">
                                        <option value="0">All Grades</option>
                                        @foreach (var grade in Model.Grades)
                                        {
                                            <option value="@grade.Value">@grade.Text</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="Section" class="form-label">Section</label>
                                    <select asp-for="Section" id="Section" class="form-select">
                                        <option value="">All Sections</option>
                                        @foreach (var sectionName in Model.SectionOptions)
                                        {
                                            <option value="@sectionName">@sectionName</option>
                                        }
                                    </select>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="FromDate" class="form-label">Visit From <span class="text-danger">*</span></label>
                                    <input asp-for="FromDate" type="date" class="form-control" />
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="ToDate" class="form-label">Visit To <span class="text-danger">*</span></label>
                                    <input asp-for="ToDate" type="date" class="form-control" />
                                </div>

                                <div class="col-md-3 d-flex align-items-end gap-2 flex-wrap">
                                    <button type="submit" asp-page-handler="Search" class="btn btn-primary">
                                        <i class="mdi mdi-magnify"></i> Search
                                    </button>
                                    <button type="submit" asp-page-handler="DownloadExcel" class="btn btn-success">
                                        <i class="mdi mdi-file-excel"></i> Download Excel
                                    </button>
                                    <a asp-page="/Admin/FollowupReport" class="btn btn-light">Clear</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.HasSearched)
        {
            <div class="row mt-3">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">Results (@Model.ReportRows.Count)</h5>
                            </div>
                            <div class="table-responsive table-card">
                                <table id="followupReportTable" class="table table-nowrap table-striped align-middle mb-0" aria-label="Student follow-up visits">
                                    <thead class="table-primary">
                                        <tr>
                                            <th>Visit Date</th>
                                            <th>Institution</th>
                                            <th>Grade</th>
                                            <th>Section</th>
                                            <th>Incharge</th>
                                            <th>Contact</th>
                                            <th>Sit together</th>
                                            <th class="text-end">Last month present</th>
                                            <th class="text-end">Last month working days</th>
                                            <th class="text-end">Last month %</th>
                                            <th class="text-end">Male</th>
                                            <th class="text-end">Female</th>
                                            <th class="text-end">Present today</th>
                                            <th class="text-end">Total students</th>
                                            <th class="text-end">Today %</th>
                                            <th>Created By</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Model.ReportRows)
                                        {
                                            <tr>
                                                <td data-order="@row.FollowupDate.ToString("yyyy-MM-dd")">@row.FollowupDate.ToString("dd-MMM-yyyy")</td>
                                                <td>@row.InstitutionName</td>
                                                <td>@row.GradeName</td>
                                                <td>@row.Section</td>
                                                <td>@row.InchargeName</td>
                                                <td>@row.InchargeContactNumber</td>
                                                <td>@row.IsChildSitTogether</td>
                                                <td class="text-end">@row.LastMonthAttendanceCount</td>
                                                <td class="text-end">@row.LastMonthWorkingDayCount</td>
                                                <td class="text-end">@(row.LastMonthAttendancePercentage?.ToString("0.##"))</td>
                                                <td class="text-end">@row.MaleStudentCount</td>
                                                <td class="text-end">@row.FemaleStudentCount</td>
                                                <td class="text-end">@row.TodayStudentPresentCount</td>
                                                <td class="text-end">@row.TotalStudentCount</td>
                                                <td class="text-end">@(row.TotalStudentPercentage?.ToString("0.##"))</td>
                                                <td>@row.CreatedByName</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <style>
        .select2-container {
            width: 100% !important;
        }
        .select2-container--bootstrap-5 .select2-selection {
            min-height: 38px;
        }
    </style>
    <script>
        (function () {
            const stateSelect = document.getElementById('StateId');
            const divisionSelect = document.getElementById('DivisionId');
            const institutionSelect = document.getElementById('InstitutionId');
            const gradeSelect = document.getElementById('GradeId');
            const sectionSelect = document.getElementById('Section');
            const selectedSection = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Section ?? string.Empty));

            function clearOptions(select, keepFirst) {
                while (select.options.length > (keepFirst ? 1 : 0)) {
                    select.remove(keepFirst ? 1 : 0);
                }
            }

            function setOptions(select, items, valueKey, textKey) {
                clearOptions(select, true);
                (items || []).forEach(function (item) {
                    const opt = document.createElement('option');
                    opt.value = item[valueKey];
                    opt.textContent = item[textKey];
                    select.appendChild(opt);
                });
            }

            function setSections(sections) {
                clearOptions(sectionSelect, true);
                (sections || []).forEach(function (name) {
                    const opt = document.createElement('option');
                    opt.value = name;
                    opt.textContent = name;
                    if (selectedSection && selectedSection === name) {
                        opt.selected = true;
                    }
                    sectionSelect.appendChild(opt);
                });
            }

            function setGrades(grades) {
                clearOptions(gradeSelect, true);
                (grades || []).forEach(function (g) {
                    const opt = document.createElement('option');
                    opt.value = g.id;
                    opt.textContent = g.gradeName;
                    gradeSelect.appendChild(opt);
                });
                setSections([]);
            }

            $('#InstitutionId').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'All Institutions',
                allowClear: true,
                minimumResultsForSearch: 0
            });

            async function loadDivisions() {
                const stateId = stateSelect.value || '0';
                const response = await fetch('?handler=DivisionsByState&stateId=' + encodeURIComponent(stateId));
                const data = response.ok ? await response.json() : [];
                setOptions(divisionSelect, data, 'value', 'text');
                await loadInstitutions();
            }

            async function loadInstitutions() {
                const stateId = stateSelect.value || '0';
                const divisionId = divisionSelect.value || '0';
                const response = await fetch('?handler=Institutions&stateId=' + encodeURIComponent(stateId) + '&divisionId=' + encodeURIComponent(divisionId));
                const data = response.ok ? await response.json() : [];
                const current = institutionSelect.value;
                setOptions(institutionSelect, data, 'value', 'text');
                if (current && Array.from(institutionSelect.options).some(function (o) { return o.value === current; })) {
                    institutionSelect.value = current;
                } else {
                    institutionSelect.value = '0';
                }
                $('#InstitutionId').trigger('change.select2');
                await loadGradeSections(institutionSelect.value);
            }

            async function loadGradeSections(institutionId) {
                if (!institutionId || institutionId === '0') {
                    setGrades([]);
                    return;
                }

                try {
                    const response = await fetch('?handler=GradeSections&institutionId=' + encodeURIComponent(institutionId));
                    const data = response.ok ? await response.json() : [];
                    setGrades(data);
                } catch (e) {
                    setGrades([]);
                }
            }

            stateSelect.addEventListener('change', function () {
                loadDivisions();
            });

            divisionSelect.addEventListener('change', function () {
                loadInstitutions();
            });

            $('#InstitutionId').on('change', function () {
                loadGradeSections($(this).val() || '0');
            });

            gradeSelect.addEventListener('change', async function () {
                const institutionId = institutionSelect.value;
                if (!institutionId || institutionId === '0') {
                    setSections([]);
                    return;
                }

                try {
                    const response = await fetch('?handler=GradeSections&institutionId=' + encodeURIComponent(institutionId));
                    const data = response.ok ? await response.json() : [];
                    const gradeId = parseInt(gradeSelect.value || '0', 10);
                    const match = (data || []).find(function (g) { return g.id === gradeId; });
                    setSections(match ? match.sections : []);
                } catch (e) {
                    setSections([]);
                }
            });

            @if (Model.HasSearched)
            {
                <text>
                $('#followupReportTable').DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    pageLength: 25,
                    order: [[0, 'desc']]
                });
                </text>
            }
        })();
    </script>
}
