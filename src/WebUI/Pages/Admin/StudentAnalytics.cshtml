@page
@model WebUI.Pages.Admin.StudentAnalyticsModel
@{
    ViewData["Title"] = "Student Analytics";
    var funnelLabels = System.Text.Json.JsonSerializer.Serialize(Model.FunnelItems.Select(x => x.Label));
    var funnelCounts = System.Text.Json.JsonSerializer.Serialize(Model.FunnelItems.Select(x => x.Count));
    var dimensionHeader = Model.GroupBy == "INSTITUTION" ? "Institution" : "Division";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-sm-flex align-items-center justify-content-between">
                    <h4 class="mb-sm-0">Student Analytics</h4>
                    <a class="btn btn-soft-secondary btn-sm"
                       asp-page="/Admin/StudentExceptions"
                               asp-route-StateId="@Model.StateId"
                               asp-route-DivisionId="@Model.DivisionId"
                               asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                               asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                               asp-route-IncludeAll="@Model.IncludeAll"
                               asp-route-IncludeKadam="@Model.IncludeKadam"
                               asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus">
                        View exceptions
                    </a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form method="get">
                            <div asp-validation-summary="All" class="text-danger mb-3"></div>
                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label asp-for="StateId" class="form-label">State</label>
                                    <select asp-for="StateId" id="StateId" class="form-select">
                                        <option value="">All States</option>
                                        @foreach (var state in Model.States)
                                        {
                                            <option value="@state.Value">@state.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="DivisionId" class="form-label">Division</label>
                                    <select asp-for="DivisionId" id="DivisionId" class="form-select">
                                        <option value="">All Divisions</option>
                                        @foreach (var division in Model.Divisions)
                                        {
                                            <option value="@division.Value">@division.Text</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="FromDate" class="form-label">From Date</label>
                                    <input asp-for="FromDate" type="date" class="form-control" />
                                </div>
                                <div class="col-md-3">
                                    <label asp-for="ToDate" class="form-label">To Date</label>
                                    <input asp-for="ToDate" type="date" class="form-control" />
                                </div>
                            </div>
                            <div class="row g-3 mt-1">
                                <div class="col-md-6">
                                    <label class="form-label d-block">Student Type</label>
                                    <div class="d-flex flex-wrap gap-4">
                                        <div class="form-check">
                                            <input asp-for="IncludeAll" class="form-check-input" type="checkbox" id="includeAll" />
                                            <label class="form-check-label" for="includeAll">All</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="IncludeKadam" class="form-check-input student-type-filter" type="checkbox" id="includeKadam" />
                                            <label class="form-check-label" for="includeKadam">Kadam</label>
                                        </div>
                                        <div class="form-check">
                                            <input asp-for="IncludeKadamPlus" class="form-check-input student-type-filter" type="checkbox" id="includeKadamPlus" />
                                            <label class="form-check-label" for="includeKadamPlus">Kadam Plus</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label d-block">Group breakdown by</label>
                                    <div class="d-flex flex-wrap gap-4">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="GroupBy" value="DIVISION" id="groupDivision" />
                                            <label class="form-check-label" for="groupDivision">Division</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" asp-for="GroupBy" value="INSTITUTION" id="groupInstitution" />
                                            <label class="form-check-label" for="groupInstitution">Institution</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-4">
                                <button type="submit" class="btn btn-primary">Apply Filters</button>
                                <a asp-page="/Admin/StudentAnalytics" class="btn btn-secondary">Clear</a>
                                <a class="btn btn-success"
                                   asp-page-handler="DownloadExcel"
                                   asp-route-StateId="@Model.StateId"
                                   asp-route-DivisionId="@Model.DivisionId"
                                   asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-IncludeAll="@Model.IncludeAll"
                                   asp-route-IncludeKadam="@Model.IncludeKadam"
                                   asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus"
                                   asp-route-GroupBy="@Model.GroupBy">
                                    Export breakdown Excel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Total students</div>
                        <div class="fs-3 fw-semibold">@Model.Summary.TotalStudents</div>
                        <div class="small text-muted">Active @Model.Summary.ActiveCount · Inactive @Model.Summary.InactiveCount · Completed @Model.Summary.CompletedCount</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Baseline completed</div>
                        <div class="fs-3 fw-semibold">@Model.Summary.BaselineCompletedCount</div>
                        <div class="small">@Model.Summary.BaselineCompletedPercent.ToString("0.##")%</div>
                        <a class="small" asp-page="/Admin/StudentExceptions" asp-route-ExceptionCode="NO_BASELINE"
                           asp-route-StateId="@Model.StateId" asp-route-DivisionId="@Model.DivisionId"
                           asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))" asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                           asp-route-IncludeAll="@Model.IncludeAll" asp-route-IncludeKadam="@Model.IncludeKadam" asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus">No baseline exceptions</a>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">In progress</div>
                        <div class="fs-3 fw-semibold">@Model.Summary.InProgressCount</div>
                        <div class="small text-muted">Active, baseline done, steps incomplete</div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small">Mainstream eligible</div>
                        <div class="fs-3 fw-semibold">@Model.Summary.MainstreamEligibleCount</div>
                        <a class="small" asp-page="/Admin/StudentExceptions" asp-route-ExceptionCode="READY_FOR_MAINSTREAM"
                           asp-route-StateId="@Model.StateId" asp-route-DivisionId="@Model.DivisionId"
                           asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))" asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                           asp-route-IncludeAll="@Model.IncludeAll" asp-route-IncludeKadam="@Model.IncludeKadam" asp-route-IncludeKadamPlus="@Model.IncludeKadamPlus">View list</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Progress started</div><div class="fs-4 fw-semibold">@Model.Summary.ProgressStartedCount</div></div></div></div>
            <div class="col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Steps completed</div><div class="fs-4 fw-semibold">@Model.Summary.StepsCompletedCount</div></div></div></div>
            <div class="col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Endline completed</div><div class="fs-4 fw-semibold">@Model.Summary.EndlineCompletedCount</div></div></div></div>
            <div class="col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">Mainstreamed</div><div class="fs-4 fw-semibold">@Model.Summary.MainstreamedCount</div></div></div></div>
            <div class="col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">No baseline (active)</div><div class="fs-4 fw-semibold">@Model.Summary.NoBaselineActiveCount</div></div></div></div>
            <div class="col-md-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="text-muted small">GT1–GT5</div><div class="fs-6 fw-semibold">@Model.Summary.GradeTest1Count / @Model.Summary.GradeTest2Count / @Model.Summary.GradeTest3Count / @Model.Summary.GradeTest4Count / @Model.Summary.GradeTest5Count</div></div></div></div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary mb-3">Student journey funnel</h5>
                        <div id="studentJourneyFunnel" style="min-height: 320px;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title text-primary mb-3">Breakdown by @dimensionHeader</h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@dimensionHeader</th>
                                        <th>State</th>
                                        <th>Total</th>
                                        <th>Active</th>
                                        <th>Inactive</th>
                                        <th>Completed</th>
                                        <th>Baseline</th>
                                        <th>Baseline %</th>
                                        <th>Progress</th>
                                        <th>Steps</th>
                                        <th>Endline</th>
                                        <th>Mainstreamed</th>
                                        <th>Eligible</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.BreakdownRows.Any())
                                    {
                                        <tr><td colspan="13" class="text-center text-muted py-4">No data for the selected filters.</td></tr>
                                    }
                                    else
                                    {
                                        foreach (var row in Model.BreakdownRows)
                                        {
                                            <tr>
                                                <td>@row.DimensionName</td>
                                                <td>@row.StateName</td>
                                                <td>@row.TotalStudents</td>
                                                <td>@row.ActiveCount</td>
                                                <td>@row.InactiveCount</td>
                                                <td>@row.CompletedCount</td>
                                                <td>@row.BaselineCompletedCount</td>
                                                <td>@row.BaselineCompletedPercent.ToString("0.##")</td>
                                                <td>@row.ProgressStartedCount</td>
                                                <td>@row.StepsCompletedCount</td>
                                                <td>@row.EndlineCompletedCount</td>
                                                <td>@row.MainstreamedCount</td>
                                                <td>@row.MainstreamEligibleCount</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        (function () {
            const includeAll = document.getElementById('includeAll');
            const typeFilters = document.querySelectorAll('.student-type-filter');
            function syncStudentTypeFilters() {
                if (includeAll.checked) typeFilters.forEach(function (c) { c.checked = false; });
            }
            includeAll.addEventListener('change', syncStudentTypeFilters);
            typeFilters.forEach(function (checkbox) {
                checkbox.addEventListener('change', function () {
                    if (checkbox.checked) includeAll.checked = false;
                });
            });
            syncStudentTypeFilters();

            const stateSelect = document.getElementById('StateId');
            const divisionSelect = document.getElementById('DivisionId');
            function escapeHtml(value) {
                return String(value ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
            }
            async function loadDivisionsForState() {
                if (!stateSelect || !divisionSelect) return;
                const response = await fetch(`?handler=DivisionsByState&stateId=${encodeURIComponent(stateSelect.value || '')}`);
                if (!response.ok) return;
                const data = await response.json();
                divisionSelect.innerHTML = ['<option value="">All Divisions</option>']
                    .concat((data || []).map(function (d) { return `<option value="${d.value}">${escapeHtml(d.text)}</option>`; }))
                    .join('');
                divisionSelect.value = '';
            }
            stateSelect?.addEventListener('change', loadDivisionsForState);

            const chart = new ApexCharts(document.querySelector('#studentJourneyFunnel'), {
                chart: { type: 'bar', height: 320, toolbar: { show: false } },
                series: [{ name: 'Students', data: @Html.Raw(funnelCounts) }],
                plotOptions: { bar: { horizontal: true, borderRadius: 4, barHeight: '60%' } },
                dataLabels: { enabled: true },
                xaxis: { categories: @Html.Raw(funnelLabels) },
                colors: ['#405189']
            });
            chart.render();
        })();
    </script>
}
