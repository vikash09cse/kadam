@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-content">
    <div class="container-fluid">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Student Dashboard</h4>
            <a href="/StudentPortal/Registration" class="btn btn-primary"><i class="ri-user-add-line"></i> Register Student</a>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-white" style="background-color: #4CAF50;">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="mdi mdi-account-check fs-4 me-2"></i>
                            <span class="fw-semibold">Active</span>
                        </div>
                        <h2 class="mb-0 text-center fw-bold">@Model.Dashboard.ActiveCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-white" style="background-color: #FFC107;">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="mdi mdi-account-off fs-4 me-2"></i>
                            <span class="fw-semibold">Inactive</span>
                        </div>
                        <h2 class="mb-0 text-center fw-bold">@Model.Dashboard.InactiveCount</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 text-white" style="background-color: #2196F3;">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-2">
                            <i class="mdi mdi-account-star fs-4 me-2"></i>
                            <span class="fw-semibold">Completed</span>
                        </div>
                        <h2 class="mb-0 text-center fw-bold">@Model.Dashboard.CompletedCount</h2>
                    </div>
                </div>
            </div>
        </div>
        <div class="card"><div class="card-body d-flex gap-2">
            <a href="/StudentPortal/Directory" class="btn btn-outline-primary">Student List</a>
            <a href="/StudentPortal/Registration" class="btn btn-outline-primary">New Registration</a>
        </div></div>
    </div>
</div>
