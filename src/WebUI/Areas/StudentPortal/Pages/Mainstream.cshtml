@page
@model MainstreamModel
@{
    ViewData["Title"] = "Mainstream Student";
}

<div class="page-content">
    <div class="container-fluid">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Mainstream Student</h4>
            <a href="/StudentPortal/MyInstitution" class="btn btn-secondary">Back to My Institution</a>
        </div>

        <form method="post" class="card">
            <div class="card-header text-center">
                <h5 class="card-title mb-0">Mainstream Information</h5>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input asp-for="Mainstream.StudentId" type="hidden" />
                <input asp-for="Mainstream.EnrolledInstitutionId" type="hidden" />

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Student</label>
                        <input class="form-control" value="@Model.Mainstream.StudentName (@Model.Mainstream.StudentCode)" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Enrolled Institution</label>
                        <input class="form-control" value="@Model.Mainstream.EnrolledInstitutionName" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Enrolled Grade</label>
                        <input class="form-control" value="@Model.Mainstream.EnrolledGradeName" readonly />
                    </div>
                </div>

                <div class="form-check form-switch mb-3">
                    <input asp-for="Mainstream.IsMainstreamInstitutionSame" class="form-check-input" />
                    <label asp-for="Mainstream.IsMainstreamInstitutionSame" class="form-check-label">Mainstream institution is the same as enrolled institution</label>
                </div>

                <div id="other-institution-fields" class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="Mainstream.StateId" class="form-label">State</label>
                        <select asp-for="Mainstream.StateId" id="mainstream-state" class="form-select">
                            <option value="">Select state</option>
                            @foreach (var item in Model.States) { <option value="@item.Id">@item.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Mainstream.DistrictId" class="form-label">District</label>
                        <select asp-for="Mainstream.DistrictId" id="mainstream-district" class="form-select">
                            <option value="">Select district</option>
                            @foreach (var item in Model.Districts) { <option value="@item.Id">@item.Text</option> }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Mainstream.MainstreamInstitutionId" class="form-label">Institution</label>
                        <select asp-for="Mainstream.MainstreamInstitutionId" id="mainstream-institution" class="form-select">
                            <option value="">Select institution</option>
                            @foreach (var item in Model.Institutions) { <option value="@item.Id">@item.Text</option> }
                        </select>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Mainstream.GradeId" class="form-label">Mainstream Grade <span class="text-danger">*</span></label>
                        <select asp-for="Mainstream.GradeId" id="mainstream-grade" class="form-select" required>
                            <option value="">Select grade</option>
                            @foreach (var item in Model.GradeSections)
                            {
                                <option value="@item.Id" data-sections="@item.Sections">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Mainstream.Section" class="form-label">Section <span class="text-danger">*</span></label>
                        <select asp-for="Mainstream.Section" id="mainstream-section" class="form-select" required>
                            <option value="">Select section</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Mainstream.ChildSRNumber" class="form-label">Child SR Number</label>
                        <input asp-for="Mainstream.ChildSRNumber" id="childSRNumber" class="form-control"
                               maxlength="100" inputmode="numeric" pattern="[0-9]*" title="Numbers only"
                               autocomplete="off" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Mainstream.MainstreamDate" class="form-label">Mainstream Date <span class="text-danger">*</span></label>
                        <input asp-for="Mainstream.MainstreamDate" id="mainstreamDate" type="date" class="form-control" required
                               min="@Model.MinimumMainstreamDate.ToString("yyyy-MM-dd")"
                               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-end gap-2">
                <button type="submit" class="btn btn-success">Save</button>
                <a href="/StudentPortal/MyInstitution" class="btn btn-danger">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
(() => {
    const same = document.getElementById('Mainstream_IsMainstreamInstitutionSame');
    const state = document.getElementById('mainstream-state');
    const district = document.getElementById('mainstream-district');
    const institution = document.getElementById('mainstream-institution');
    const grade = document.getElementById('mainstream-grade');
    const section = document.getElementById('mainstream-section');
    const selectedSection = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Mainstream.Section ?? ""));

    const fill = (select, items, placeholder) => {
        select.innerHTML = `<option value="">${placeholder}</option>` +
            items.map(x => `<option value="${x.id}" data-sections="${x.sections || ''}">${x.text}</option>`).join('');
    };
    const loadSections = selected => {
        const sections = (grade.selectedOptions[0]?.dataset.sections || '').split(',').map(x => x.trim()).filter(Boolean);
        fill(section, sections.map(x => ({id:x,text:x})), 'Select section');
        if (selected) section.value = selected;
    };
    const toggleInstitution = () => {
        const isSame = same.checked;
        document.getElementById('other-institution-fields').classList.toggle('d-none', isSame);
        [state, district, institution].forEach(x => x.disabled = isSame);
    };

    state.addEventListener('change', async () => {
        fill(district, state.value ? await (await fetch(`?handler=Districts&stateId=${state.value}`)).json() : [], 'Select district');
        fill(institution, [], 'Select institution');
    });
    district.addEventListener('change', async () => {
        fill(institution, district.value ? await (await fetch(`?handler=Institutions&stateId=${state.value}&districtId=${district.value}`)).json() : [], 'Select institution');
    });
    grade.addEventListener('change', () => loadSections(''));
    same.addEventListener('change', toggleInstitution);

    loadSections(selectedSection);
    document.getElementById('other-institution-fields').classList.toggle('d-none', same.checked);
    [state, district, institution].forEach(x => x.disabled = same.checked);

    document.querySelector('form')?.addEventListener('submit', event => {
        if (!same.checked) {
            if (!state.value) {
                event.preventDefault();
                alert('State, district, and mainstream institution are required.');
                state.focus();
                return;
            }
            if (!district.value) {
                event.preventDefault();
                alert('State, district, and mainstream institution are required.');
                district.focus();
                return;
            }
            if (!institution.value) {
                event.preventDefault();
                alert('State, district, and mainstream institution are required.');
                institution.focus();
                return;
            }
        }
        if (!grade.value) {
            event.preventDefault();
            alert('Grade is required.');
            grade.focus();
            return;
        }
        if (!section.value) {
            event.preventDefault();
            alert('Section is required.');
            section.focus();
            return;
        }
        const dateInput = document.getElementById('mainstreamDate') ||
            document.querySelector('[name="Mainstream.MainstreamDate"]');
        if (!dateInput?.value) {
            event.preventDefault();
            alert('Mainstream date is required.');
            dateInput?.focus();
            return;
        }
        const minDate = dateInput.min ? new Date(dateInput.min + 'T00:00:00') : null;
        const maxDate = dateInput.max ? new Date(dateInput.max + 'T00:00:00') : null;
        const selectedDate = new Date(dateInput.value + 'T00:00:00');
        if (minDate && selectedDate < minDate) {
            event.preventDefault();
            alert(`Mainstream date cannot be earlier than ${dateInput.min} (one session/year prior to the current session).`);
            dateInput.focus();
            return;
        }
        if (maxDate && selectedDate > maxDate) {
            event.preventDefault();
            alert('Mainstream date cannot be in the future.');
            dateInput.focus();
            return;
        }
        const childSr = document.getElementById('childSRNumber');
        const childSrValue = (childSr?.value || '').replace(/\D/g, '');
        if (childSr) childSr.value = childSrValue;
        if (childSr?.value && !/^\d+$/.test(childSr.value)) {
            event.preventDefault();
            alert('Child SR number must contain numbers only. Alphabetic characters are not allowed.');
            childSr.focus();
        }
    });

    const childSrInput = document.getElementById('childSRNumber');
    const stripNonDigits = el => {
        const digitsOnly = (el.value || '').replace(/\D/g, '');
        if (el.value !== digitsOnly) el.value = digitsOnly;
    };
    childSrInput?.addEventListener('input', event => stripNonDigits(event.target));
    childSrInput?.addEventListener('blur', event => stripNonDigits(event.target));
    childSrInput?.addEventListener('keypress', event => {
        if (event.key && event.key.length === 1 && !/[0-9]/.test(event.key))
            event.preventDefault();
    });
    childSrInput?.addEventListener('paste', event => {
        event.preventDefault();
        const text = (event.clipboardData || window.clipboardData)?.getData('text') || '';
        const digits = text.replace(/\D/g, '');
        const el = event.target;
        const start = el.selectionStart ?? el.value.length;
        const end = el.selectionEnd ?? el.value.length;
        el.value = el.value.slice(0, start) + digits + el.value.slice(end);
    });
})();
</script>
}

<style>.validation-summary-valid { display: none; }</style>
